# 统一换行与文本处理，避免 Windows/Linux 协作时出现整文件 diff
* text=auto eol=lf

# 明确二进制类型
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.gguf binary
*.db binary
*.sqlite3 binary
*.pyc binary

# 生成物/导出物标记为「在 GitHub 语言统计中不计入」
storage/** linguist-generated=true
examples/phase2_demo_cases.json linguist-generated=true
