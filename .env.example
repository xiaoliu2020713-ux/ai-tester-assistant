# =============================================================================
# AI 测试员助手平台 - 环境变量示例
# 复制为 .env 后按需修改。界面上的模型配置区优先级高于此文件（会话内实时生效）。
# =============================================================================

# ---------- 本地大模型（默认，OpenAI 兼容接口）----------
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=qwen3.5:4b
LOCAL_LLM_API_KEY=sk-local

# ---------- DeepSeek（或其他 OpenAI 兼容云服务）----------
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# ---------- 当前激活的提供方：local | deepseek | custom ----------
LLM_PROVIDER=local

# ---------- 向量模型（RAG 检索用）----------
# openai_api : 调用 OpenAI 兼容的 /v1/embeddings（本地 8080 若支持则最省资源）
# sentence_transformer : 本地 HuggingFace 模型（需安装 sentence-transformers）
# hash : 纯 Python 确定性哈希向量（零依赖兜底，检索质量较弱）
# auto : 依次探测 openai_api -> sentence_transformer -> hash
EMBEDDING_PROVIDER=auto
EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=sk-local
EMBEDDING_ST_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 知识库 / 向量库 ----------
CHROMA_DIR=storage/chroma
DEFAULT_DOMAIN=library

# ---------- 生成参数 ----------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=180
LLM_STREAM=true
HISTORY_MAX_TURNS=8
